{
  "name": "votacion-directivas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Votación en tiempo real para directivas de iglesia (Firebase + GitHub Pages)",
  "scripts": {
    "start": "npx --yes serve . -l 3000",
    "test:logic": "node --test tests/logic.test.js",
    "test:rules": "node --test tests/rules.test.js",
    "test:load": "node tests/load-sim.js",
    "test": "node --test tests/logic.test.js tests/rules.test.js && node tests/load-sim.js",
    "test:emu": "firebase emulators:exec --only firestore --project demo-votacion \"npm test\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "firebase": "10.14.1",
    "firebase-tools": "^13.29.0"
  }
}

